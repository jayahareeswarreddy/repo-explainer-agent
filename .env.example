# Copy to .env and fill in. Never commit the real .env.
GROQ_API_KEY=your_groq_api_key_here
# Free embeddings API key from https://jina.ai/embeddings (no card needed)
JINA_API_KEY=your_jina_api_key_here
# Optional: raises GitHub API rate limit (60/hr -> 5000/hr). A read-only token is fine.
GITHUB_TOKEN=
